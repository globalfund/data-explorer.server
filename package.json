{
  "name": "data-explorer-server",
  "version": "1.0.0",
  "private": true,
  "description": "data-explorer-server",
  "license": "MIT",
  "keywords": [
    "data-explorer-server",
    "api",
    "middleware",
    "data",
    "the-global-fund"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "lb-tsc",
    "build:watch": "lb-tsc --watch",
    "lint": "yarn run eslint && yarn run prettier:check",
    "lint:fix": "yarn run eslint:fix && yarn run prettier:fix",
    "prettier:cli": "lb-prettier \"**/*.ts\" \"**/*.js\"",
    "prettier:check": "yarn run prettier:cli -l",
    "prettier:fix": "yarlin run prettier:cli --write",
    "eslint": "lb-eslint --report-unused-disable-directives .",
    "eslint:fix": "yarn run eslint --fix",
    "pretest": "yarn run rebuild",
    "test": "lb-mocha --allow-console-logs \"dist/__tests__\"",
    "prestart": "yarn run rebuild",
    "start": "node -r source-map-support/register .",
    "worker": "node -r source-map-support/register dist/workers/report.worker.js",
    "clean": "lb-clean dist *.tsbuildinfo .eslintcache",
    "rebuild": "yarn run clean && yarn run build",
    "dev": "nodemon server.js",
    "dev:all": "pm2-runtime pm2.dev.config.js",
    "worker:dev": "nodemon --watch src --ext ts,json --exec ts-node src/workers/report.worker.ts",
    "deploy": "yarn prestart && pm2 start pm2.config.js --env production",
    "docker": "yarn prestart && pm2-runtime start pm2.config.js --env production"
  },
  "nodemonConfig": {
    "verbose": true,
    "watch": [
      "src/"
    ],
    "ignore": [
      "dist/*"
    ],
    "ext": "ts",
    "exec": "npm start"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/globalfund/data-explorer-server.git"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "dependencies": {
    "@loopback/authentication": "^12.0.15",
    "@loopback/authentication-jwt": "^0.16.15",
    "@loopback/boot": "^8.0.14",
    "@loopback/core": "^7.0.13",
    "@loopback/repository": "^8.0.13",
    "@loopback/rest": "^15.0.14",
    "@loopback/rest-explorer": "^8.0.14",
    "@loopback/security": "^0.12.14",
    "@loopback/service-proxy": "^8.0.13",
    "@rawgraphs/rawgraphs-core": "^1.0.0-beta.17",
    "@turf/center": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@types/lodash": "^4.17.14",
    "@types/multer": "^2.1.0",
    "axios": "^1.16.0",
    "bullmq": "^5.76.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.3.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "lodash": "^4.18.1",
    "loopback-connector-mongodb": "^8.0.0",
    "map-transform": "^0.3.12",
    "moment": "^2.30.1",
    "multer": "^2.2.0",
    "nodemon": "^3.1.9",
    "puppeteer": "^24.42.0",
    "querystring": "^0.2.1",
    "sharp": "^0.35.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@loopback/build": "^12.0.13",
    "@loopback/eslint-config": "^16.0.1",
    "@loopback/testlab": "^8.0.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "pm2": "^7.0.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "resolutions": {
    "**/hyperid/uuid": "11.1.1",
    "**/mocha/diff": "8.0.3",
    "pm2/js-yaml": "4.3.1",
    "serialize-javascript": "7.0.5",
    "undici": "6.28.0"
  }
}
